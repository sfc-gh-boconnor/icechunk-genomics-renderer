-- =============================================================================
-- GRAGEN — genome-wide variant ingest job  (TEMPLATE)
-- =============================================================================
-- Rendered by setup.sh (envsubst) -> sql/_rendered/run_genome_ingest_job.sql.
-- Launches the long-running ingest of all chromosomes into the IceChunk Zarr
-- store at s3://${S3_BUCKET}/${DEPLOY_PREFIX}/genomics_repo/ .
-- Run AFTER the backend image is pushed and setup.sh has completed.
--   snow sql -c <CONNECTION> -f sql/_rendered/run_genome_ingest_job.sql
-- =============================================================================
EXECUTE JOB SERVICE
  IN COMPUTE POOL GRAGEN_INGEST_POOL
  NAME = GRAGEN_DB.GRAGEN.GRAGEN_GENOME_INGEST
  EXTERNAL_ACCESS_INTEGRATIONS = (ICECHUNK_S3_EAI, GENOMICS_1000G_EAI)
  FROM SPECIFICATION $$
spec:
  containers:
  - name: seed
    image: /gragen_db/gragen/gragen_repo/gragen-service:1.0.26
    command: ["python3", "/app/seed_job.py"]
    env:
      SEED_TYPE: genomics
      SEED_CHROMS: "chr21,chr19,chr20,chr18,chr17,chr16,chr15,chr14,chr13,chr12,chr11,chr10,chr9,chr8,chr7,chr6,chr5,chr4,chr3,chr2,chr1,chrX"
      ICECHUNK_BUCKET: "${S3_BUCKET}"
      ICECHUNK_GENOMICS_PREFIX: "${DEPLOY_PREFIX}/genomics_repo"
      AWS_DEFAULT_REGION: "${AWS_REGION}"
      INGEST_WORKERS: "16"
    secrets:
    - snowflakeSecret:
        objectName: GRAGEN_DB.GRAGEN.AWS_ACCESS_KEY_ID
      envVarName: AWS_ACCESS_KEY_ID
    - snowflakeSecret:
        objectName: GRAGEN_DB.GRAGEN.AWS_SECRET_ACCESS_KEY
      envVarName: AWS_SECRET_ACCESS_KEY
$$;
