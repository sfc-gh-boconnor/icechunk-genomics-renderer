# =============================================================================
# GRAGEN Genomics Accelerator — deployment configuration
# =============================================================================
# Copy this file to `config.env` and fill in your own values.
# `config.env` is gitignored and must NEVER be committed (it holds AWS creds).
#
#   cp config.env.example config.env
#   # edit DEPLOY_PREFIX / S3_BUCKET / AWS_REGION below
#   bash provision_aws.sh    # creates bucket + IAM user/role; auto-fills the AWS
#                            # key/secret + ICEBERG_ROLE_ARN fields below for you
#   bash setup.sh            # one-time Snowflake setup (creates volume + secrets)
#   bash provision_aws.sh --trust   # finalize the IAM role trust policy
#   bash deploy.sh           # build + deploy the SPCS services
#
# Multiple SEs: each has their OWN Snowflake account but SHARES one AWS account.
# Pick a unique DEPLOY_PREFIX — it namespaces your S3 paths and IAM names so
# nothing collides with other SEs in the shared AWS account. Snowflake objects
# are NOT prefixed (they're already isolated by being in your own account).
# =============================================================================

# Snowflake CLI connection name (from ~/.snowflake/connections.toml).
# The credential must allow MULTI-ROLE access including ACCOUNTADMIN. If using a
# programmatic access token (PAT), create it with multiple roles (not a single
# restricted role) — a restricted PAT blocks USE ROLE and can't create the EAIs
# or the Iceberg external volume.
GRAGEN_CONNECTION="internal-marketplace"

# -----------------------------------------------------------------------------
# Unique storage prefix.
# -----------------------------------------------------------------------------
# Namespaces ALL storage for this deployment inside your bucket so multiple
# accounts/teams can never collide:
#   s3://<S3_BUCKET>/<DEPLOY_PREFIX>/genomics_repo/   (IceChunk Zarr - variants)
#   s3://<S3_BUCKET>/<DEPLOY_PREFIX>/clinvar_repo/    (IceChunk Zarr - ClinVar)
#   s3://<S3_BUCKET>/<DEPLOY_PREFIX>/iceberg/         (Iceberg external volume)
# MUST be lowercase letters, digits and underscores only:  ^[a-z0-9_]+$
# Pick something unique to you, e.g. your team or account name.
DEPLOY_PREFIX="my_team"

# -----------------------------------------------------------------------------
# Your S3 bucket (shared across SEs; isolated by DEPLOY_PREFIX).
# -----------------------------------------------------------------------------
# IMPORTANT: create the bucket in the SAME region as your Snowflake account
# (check with: SELECT CURRENT_REGION();). A cross-region bucket makes the
# IceChunk Zarr ingest 5-10x slower (every write crosses regions). SFSEHOL
# accounts are us-west-2, so use us-west-2 there.
S3_BUCKET="my-genomics-bucket"
AWS_REGION="us-west-2"

# AWS access key with read/write on s3://<S3_BUCKET>/<DEPLOY_PREFIX>/* .
# AUTO-FILLED by `provision_aws.sh` (creates the IAM user + key). Leave as-is.
AWS_ACCESS_KEY_ID="TO_BE_FILLED_BY_provision_aws.sh"
AWS_SECRET_ACCESS_KEY="TO_BE_FILLED_BY_provision_aws.sh"

# -----------------------------------------------------------------------------
# IAM role ARN for the Snowflake Iceberg external volume.
# -----------------------------------------------------------------------------
# AUTO-FILLED by `provision_aws.sh` (creates <prefix>_gragen_iceberg_role).
# After `setup.sh`, run `provision_aws.sh --trust` to set its trust policy.
ICEBERG_ROLE_ARN="TO_BE_FILLED_BY_provision_aws.sh"
